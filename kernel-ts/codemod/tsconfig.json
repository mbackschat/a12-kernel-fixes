{
  "extends": "@com.mgmtp.a12.devtools/tsconfig",
  "include": ["src", "test"],
  "exclude": ["test/fixtures"],
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": ".",
    "target": "es6",
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
