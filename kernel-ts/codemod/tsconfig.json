{
  "extends": "@com.mgmtp.a12.devtools/tsconfig",
  "include": [
    "src"
  ],
  "exclude": [
    "**/__fixtures__/**"
  ],
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
		"module": "CommonJS",
    "ignoreDeprecations": "6.0", // damit moduleResolution node bleiben kann
		"moduleResolution": "node",
    "declarationMap": false,
    "declaration": false,
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": ["node", "jest"]
  },
  "ts-node": {
    "transpileOnly": true
  }
}