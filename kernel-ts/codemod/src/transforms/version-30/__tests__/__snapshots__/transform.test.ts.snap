import { arraysEqual } from "@com.mgmtp.a12.kernel/kernel-md-facade/a12internal";
import { nl } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { fr } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { en } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { de } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { RuntimeFormalErrorEnum } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { ERROR_DURING_DATA_CHECK_EVAL } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { DIVISION_BY_ZERO_INVALID } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { StaticResourceProvider } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { ErrorLocalizationBundle } from "@com.mgmtp.a12.kernel/kernel-md-facade";
import { defaultResourceProvider } from "@com.mgmtp.a12.kernel/kernel-md-facade";

function test() {
	de.set(RuntimeFormalErrorEnum.COMMA_PLURAL, "Kommas");
	en.set(RuntimeFormalErrorEnum.COMMA_PLURAL, "Kommas");
	fr.set(RuntimeFormalErrorEnum.COMMA_PLURAL, "Kommas");
	nl.set(RuntimeFormalErrorEnum.COMMA_PLURAL, "Kommas");
	const es = new ErrorLocalizationBundle("es");
	es.set(RuntimeFormalErrorEnum.COMMA_PLURAL, "Kommas");

	const customResourceProvider = new StaticResourceProvider(de, en);
	customResourceProvider.gettext(\`kernel-formalErrors.\${DIVISION_BY_ZERO_INVALID}\`, "es");
	defaultResourceProvider.gettext(\`kernel-formalErrors.\${ERROR_DURING_DATA_CHECK_EVAL}\`, "es");

	arraysEqual([1, 2], [3, 4]); // unrelated, import should not change
}
`;

