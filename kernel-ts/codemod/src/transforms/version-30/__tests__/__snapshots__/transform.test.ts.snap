exports[`com.mgmtp.a12.kernel.kernel-codemod.Deprecation of RtCustomExtensionService.registerCustomConditions should work: \\nFixture: 10.ts\\n---\\nimport {\\n  getCodeEditorErrors,\\n  getValidationState,\\n  ValidationStatus\\n} from "@com.mgmtp.a12.antlrcodeeditor/antlrcodeeditor-core";\\nimport { ICustomCondition } from "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts/lib/main/js/a12internal/index.js";\\nimport { RtCustomExtensionService } from "@com.mgmtp.a12.kernel/kernel-md-facade/lib/main/js/a12internal/RtCustomExtensionService.js";\\n\\n\\nexport function registerCustomConditions() {\\n  const conditionsMap: Record<string, ICustomCondition> = {\\n    CodeEditorCondition: {\\n      check(data, relevantEntities, formallyIncorrectFields, errorField) {\\n        const fieldContent = data.getValue(errorField);\\n        if (fieldContent) {\\n          const errors = getCodeEditorErrors("example");\\n          return errors.length > 0;\\n        }\\n\\n        return false;\\n      }\\n    },\\n    CodeEditorPendingValidation: {\\n      check(data, relevantEntities, formallyIncorrectFields, errorField) {\\n        const fieldContent = data.getValue(errorField);\\n        if (fieldContent) {\\n          const pendingValidations = getValidationState({\\n            owner: "example",\\n            status: ValidationStatus.CHECKING\\n          });\\n          return pendingValidations.length > 0;\\n        }\\n\\n        return false;\\n      }\\n    },\\n    ProjectConditionWarning: {\\n      check(data, relevantEntities, formallyIncorrectFields, errorField) {\\n        const fieldContent = data.getValue(errorField);\\n        if (fieldContent) {\\n          const regex = ".*warning.*";\\n          return new RegExp(regex, "m").test(fieldContent);\\n        }\\n\\n        return false;\\n      }\\n    },\\n    ProjectConditionError: {\\n      check(data, relevantEntities, formallyIncorrectFields, errorField) {\\n        const fieldContent = data.getValue(errorField);\\n        if (fieldContent) {\\n          const regex = ".*error.*";\\n          return new RegExp(regex, "m").test(fieldContent);\\n        }\\n\\n        return false;\\n      }\\n    }\\n  };\\n\\n  RtCustomExtensionService.registerCustomConditions({\\n    createCustomCondition(name: string) {\\n      return conditionsMap[name];\\n    }\\n  });\\n}\\n---\\n 1`] = `
import {
  getCodeEditorErrors,
  getValidationState,
  ValidationStatus
} from "@com.mgmtp.a12.antlrcodeeditor/antlrcodeeditor-core";
import { ICustomCondition } from "@com.mgmtp.a12.kernel/kernel-md-facade/a12internal";
import { RtCustomExtensionService } from "@com.mgmtp.a12.kernel/kernel-md-facade/a12internal";


export function registerCustomConditions() {
  const conditionsMap: Record<string, ICustomCondition> = {
    CodeEditorCondition: {
      check(data, relevantEntities, formallyIncorrectFields, errorField) {
        const fieldContent = data.getValue(errorField);
        if (fieldContent) {
          const errors = getCodeEditorErrors("example");
          return errors.length > 0;
        }

        return false;
      }
    },
    CodeEditorPendingValidation: {
      check(data, relevantEntities, formallyIncorrectFields, errorField) {
        const fieldContent = data.getValue(errorField);
        if (fieldContent) {
          const pendingValidations = getValidationState({
            owner: "example",
            status: ValidationStatus.CHECKING
          });
          return pendingValidations.length > 0;
        }

        return false;
      }
    },
    ProjectConditionWarning: {
      check(data, relevantEntities, formallyIncorrectFields, errorField) {
        const fieldContent = data.getValue(errorField);
        if (fieldContent) {
          const regex = ".*warning.*";
          return new RegExp(regex, "m").test(fieldContent);
        }

        return false;
      }
    },
    ProjectConditionError: {
      check(data, relevantEntities, formallyIncorrectFields, errorField) {
        const fieldContent = data.getValue(errorField);
        if (fieldContent) {
          const regex = ".*error.*";
          return new RegExp(regex, "m").test(fieldContent);
        }

        return false;
      }
    }
  };

  // FIXME: This service is deprecated. Provide the custom conditions to the validation call directly instead (see GeneratedCodeRtConfig.customConditionFactory or ValidationMode.customConditionFactory).
  RtCustomExtensionService.registerCustomConditions({
    createCustomCondition(name: string) {
      return conditionsMap[name];
    }
  });
}
`;

