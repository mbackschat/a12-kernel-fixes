{
  "name": "@com.mgmtp.a12.kernel/kernel-codemod",
  "version": "31.3.1",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "type": "module",
  "scripts": {
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "watch": "tsc --watch",
    "runner": "node --test --test-reporter=dot",
    "test": "npm run runner -- --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=./build/npm_reports/TEST-com.mgmtp.a12.kernel-kernel-codemod.xml \"lib/test/**/*.test.js\"",
    "test:updateSnapshots": "npm run runner -- --test-update-snapshots \"lib/test/**/*.test.js\"",
    "lint": "eslint src --quiet",
    "eslint:fix": "eslint src --quiet --fix",
    "prepack": "node ../../scripts/prepack-clean.js",
    "postpack": "node ../../scripts/postpack-restore.js"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "README.md",
    "!**/test/**",
    "!**/*.test.*"
  ],
  "bin": {
    "kernel-codemod": "./bin/kernel-codemod"
  },
  "dependencies": {
    "@com.mgmtp.a12.devtools/codemod": "2.2.2",
    "ts-morph": "27.0.2"
  },
  "bundleOnPack": [
    "@com.mgmtp.a12.devtools/codemod",
    "ts-morph"
  ],
  "devDependencies": {
    "@com.mgmtp.a12.devtools/tsconfig": "^2.0.0",
    "@com.mgmtp.a12.devtools/eslint-config": "^3.1.0",
    "@com.mgmtp.a12.devtools/prettier-config": "^1.1.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-notice": "1.1.0-rc1",
    "rimraf": "^6.1.3",
    "typescript": ">=6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}