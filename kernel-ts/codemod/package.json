{
  "name": "@com.mgmtp.a12.kernel/kernel-codemod",
  "version": "31.1.1",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "scripts": {
    "start": "tsc --watch --preserveWatchOutput --noUnusedLocals false",
    "clean": "rimraf lib coverage",
    "lint": "npm run compile:eslint",
    "compile": "run-s compile:*",
    "compile:eslint": "eslint src --quiet",
    "compile:typescript": "tsc",
    "test": "jest --ci",
    "test:update": "jest -u",
    "eslint:fix": "eslint src --quiet --fix",
    "prepack": "node ../../scripts/prepack-clean.js",
    "postpack": "node ../../scripts/postpack-restore.js"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "README.md",
    "!**/__tests__/**/*"
  ],
  "bin": {
    "kernel-codemod": "./bin/kernel-codemod"
  },
  "dependencies": {
    "jscodeshift": "^17.3.0",
    "yargs": "^17.7.2"
  },
  "bundledDependencies": [
    "jscodeshift",
    "yargs"
  ],
  "jest-junit": {
    "outputDirectory": "build/npm_reports",
    "outputName": "TEST-com.mgmtp.a12.kernel-kernel-codemod.xml",
    "suiteName": "com.mgmtp.a12.kernel.kernel-codemod"
  },
  "devDependencies": {
    "@com.mgmtp.a12.devtools/tsconfig": "^2.0.0",
    "@com.mgmtp.a12.devtools/eslint-config": "^3.1.0",
    "@com.mgmtp.a12.devtools/prettier-config": "^1.1.0",
    "@types/jest": "^30.0.0",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.12.2",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.39.4",
    "eslint-plugin-notice": "1.1.0-rc1",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.9",
    "typescript": ">=6.0.2",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "tmp": "0.2.7",
    "uuid": "^11.1.1"
  }
}